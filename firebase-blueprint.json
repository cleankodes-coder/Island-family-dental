{
  "entities": {
    "ClinicConfig": {
      "title": "ClinicConfig",
      "description": "Clinic-wide operating configuration and synthetic scheduling rules",
      "type": "object",
      "properties": {
        "clinicName": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 30 },
        "timezone": { "type": "string", "maxLength": 50 },
        "minLeadHours": { "type": "number" },
        "maxFutureDays": { "type": "number" },
        "bufferMinutes": { "type": "number" },
        "slotIntervalMinutes": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["clinicName", "address", "phone", "timezone"]
    },
    "Provider": {
      "title": "Provider",
      "description": "Dentist clinician record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 100 },
        "credentials": { "type": "string", "maxLength": 200 },
        "bio": { "type": "string", "maxLength": 2000 },
        "active": { "type": "boolean" },
        "acceptsNewPatients": { "type": "boolean" },
        "supportedServiceIds": { "type": "array" }
      },
      "required": ["id", "name", "title", "active"]
    },
    "Service": {
      "title": "Service",
      "description": "Dental treatment catalog entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50 },
        "slug": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 100 },
        "category": { "type": "string", "enum": ["preventive", "restorative", "cosmetic", "emergency"] },
        "durationMinutes": { "type": "number" },
        "description": { "type": "string", "maxLength": 1000 },
        "active": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["id", "slug", "name", "category", "durationMinutes", "active"]
    },
    "WeeklyShift": {
      "title": "WeeklyShift",
      "description": "Provider weekly operational shift hours",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50 },
        "providerId": { "type": "string", "maxLength": 50 },
        "dayOfWeek": { "type": "number" },
        "startTime": { "type": "string", "maxLength": 10 },
        "endTime": { "type": "string", "maxLength": 10 },
        "isOpen": { "type": "boolean" }
      },
      "required": ["id", "providerId", "dayOfWeek", "startTime", "endTime", "isOpen"]
    },
    "ScheduleException": {
      "title": "ScheduleException",
      "description": "Time-off or schedule block for provider",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50 },
        "providerId": { "type": "string", "maxLength": 50 },
        "date": { "type": "string", "maxLength": 15 },
        "reason": { "type": "string", "maxLength": 200 },
        "allDay": { "type": "boolean" },
        "startTime": { "type": "string", "maxLength": 10 },
        "endTime": { "type": "string", "maxLength": 10 }
      },
      "required": ["id", "providerId", "date", "reason", "allDay"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Synthetic appointment request record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 60 },
        "bookingReference": { "type": "string", "maxLength": 20 },
        "providerId": { "type": "string", "maxLength": 50 },
        "serviceId": { "type": "string", "maxLength": 50 },
        "serviceName": { "type": "string", "maxLength": 100 },
        "appointmentDate": { "type": "string", "maxLength": 15 },
        "startTime": { "type": "string", "maxLength": 10 },
        "endTime": { "type": "string", "maxLength": 10 },
        "startUtc": { "type": "string", "maxLength": 40 },
        "endUtc": { "type": "string", "maxLength": 40 },
        "durationMinutes": { "type": "number" },
        "patientName": { "type": "string", "maxLength": 100 },
        "patientEmail": { "type": "string", "maxLength": 120 },
        "patientPhone": { "type": "string", "maxLength": 30 },
        "isNewPatient": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "confirmed", "rescheduled", "cancelled", "rejected", "completed", "no-show"] },
        "staffNotes": { "type": "string", "maxLength": 500 },
        "rejectionReason": { "type": "string", "maxLength": 500 },
        "cancellationReason": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "bookingReference", "providerId", "serviceId", "appointmentDate", "startTime", "endTime", "patientName", "patientEmail", "status"]
    },
    "SlotLock": {
      "title": "SlotLock",
      "description": "Provisional lock to prevent double bookings during submission",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "providerId": { "type": "string", "maxLength": 50 },
        "appointmentDate": { "type": "string", "maxLength": 15 },
        "startTime": { "type": "string", "maxLength": 10 },
        "endTime": { "type": "string", "maxLength": 10 },
        "expiresAt": { "type": "number" },
        "sessionToken": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "providerId", "appointmentDate", "startTime", "endTime", "expiresAt"]
    },
    "Enquiry": {
      "title": "Enquiry",
      "description": "General demo contact enquiry submission",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 60 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "subject": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["new", "read", "responded", "archived"] },
        "createdAt": { "type": "string", "maxLength": 40 },
        "responseNotes": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "name", "email", "message", "status", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Simulated operational staff alert",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 60 },
        "title": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "enum": ["booking_request", "booking_confirmed", "booking_cancelled", "booking_rescheduled", "enquiry_received"] },
        "relatedId": { "type": "string", "maxLength": 60 },
        "read": { "type": "boolean" },
        "simulatedChannel": { "type": "string", "maxLength": 50 },
        "simulatedDelivery": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "title", "message", "type", "read", "createdAt"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized staff or administrator record",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["admin", "receptionist", "doctor"] },
        "name": { "type": "string", "maxLength": 100 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["email", "role", "active"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit log for portal staff actions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 60 },
        "action": { "type": "string", "maxLength": 100 },
        "actorEmail": { "type": "string", "maxLength": 120 },
        "targetEntity": { "type": "string", "maxLength": 50 },
        "targetId": { "type": "string", "maxLength": 60 },
        "details": { "type": "string", "maxLength": 500 },
        "timestamp": { "type": "string", "maxLength": 40 }
      },
      "required": ["id", "action", "actorEmail", "targetEntity", "timestamp"]
    }
  },
  "firestore": {
    "/clinicConfig/{configId}": {
      "schema": "#/entities/ClinicConfig",
      "description": "Clinic-wide operating configuration"
    },
    "/providers/{providerId}": {
      "schema": "#/entities/Provider",
      "description": "Clinicians and dentists"
    },
    "/services/{serviceId}": {
      "schema": "#/entities/Service",
      "description": "Dental treatment catalog"
    },
    "/weeklyShifts/{shiftId}": {
      "schema": "#/entities/WeeklyShift",
      "description": "Weekly provider shift definitions"
    },
    "/scheduleExceptions/{exceptionId}": {
      "schema": "#/entities/ScheduleException",
      "description": "Schedule exceptions and blocked dates"
    },
    "/bookings/{bookingId}": {
      "schema": "#/entities/Booking",
      "description": "Synthetic booking records"
    },
    "/slotLocks/{lockId}": {
      "schema": "#/entities/SlotLock",
      "description": "Provisional slot locks"
    },
    "/enquiries/{enquiryId}": {
      "schema": "#/entities/Enquiry",
      "description": "General demo enquiries"
    },
    "/notifications/{notificationId}": {
      "schema": "#/entities/Notification",
      "description": "Operational notifications"
    },
    "/admins/{adminId}": {
      "schema": "#/entities/Admin",
      "description": "Portal authorized admin user accounts"
    },
    "/activityLogs/{logId}": {
      "schema": "#/entities/ActivityLog",
      "description": "Staff action audit logs"
    }
  }
}
